{
  "manifest_version": 3,
  "name": "MineTools",
  "version": "1.11.0",
  "description": "Google 搜索结果采集、Ahrefs 反链、域名注册时间查询与趋势分析，集成在浏览器侧边栏。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MineTools · 打开侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}
